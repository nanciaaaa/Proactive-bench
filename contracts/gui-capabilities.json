        ]
      }
    },
    "wangyiyun": {
      "status": "supported",
      "views": {
        "popup": [
          "title",
          "message"
        ]
      }
    },
    "chaowei": {
      "status": "supported",
      "views": {
        "popup": [
          "title",
          "message"
        ],
        "article_detail": [
          "title",
          "subtitle",
          "body"
        ]
      },
      "article_detail_device_status": "unverified"
    }
  },
  "system_surface": {
    "heads_up_notification": "missing"
  }
