{
  "schema_version": "0.1.0",
  "app_id": "wangyiyun",
  "kind": "android_app",
  "android_package": "com.ku.simulator.wangyiyun",
  "adapter_version": "wangyiyun-adapter-v1",
  "adapter_contract_version": "1.0",
  "storage_scope": [
    "local_controller_sqlite"
  ],
  "layout": "music",
  "entity_types": [
    {
      "name": "songs",
      "fields": [
        "semantic_ref",
        "title",
        "subtitle",
        "meta",
        "price",
        "available",
        "rank"
      ],
      "query_operations": [
        {
          "name": "search_songs",
          "granularity": "metadata",
          "selector_fields": [
            "keyword",
            "limit",
            "offset"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "rank"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        },
        {
          "name": "get_song_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "meta",
            "price",
            "available",
            "rank"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "playlists",
      "fields": [
        "semantic_ref",
        "title",
        "subtitle",
        "meta",
        "price",
        "available",
        "rank",
        "track_ids"
      ],
      "query_operations": [
        {
          "name": "search_playlists",
          "granularity": "metadata",
          "selector_fields": [
            "keyword",
            "limit",
            "offset"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "rank"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        },
        {
          "name": "get_playlist_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "meta",
            "price",
            "available",
            "rank",
            "track_ids"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "ui_content",
      "fields": [
        "semantic_ref",
        "hero",
        "planner",
        "profile_name"
      ],
      "query_operations": [
        {
          "name": "get_ui_content_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "hero",
            "planner",
            "profile_name"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "popup",
      "fields": [
        "semantic_ref",
        "kind",
        "title",
        "message"
      ],
      "query_operations": [
        {
          "name": "list_active_popups",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "kind",
            "title",
            "message"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "favorite",
      "fields": [
        "semantic_ref",
        "item_id"
      ],
      "query_operations": [
        {
          "name": "list_favorites",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "item_id"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "account_field",
      "fields": [
        "semantic_ref",
        "key",
        "value"
      ],
      "query_operations": [
        {
          "name": "list_account_fields",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "key",
            "value"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "play_history",
      "fields": [
        "semantic_ref",
        "item_id",
        "at",
        "playing"
      ],
      "query_operations": [
        {
          "name": "list_play_history",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "item_id",
            "at",
            "playing"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "user_playlist",
      "fields": [
        "semantic_ref",
        "name",
        "songs"
      ],
      "query_operations": [
        {
          "name": "list_user_playlists",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "name",
            "songs"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    }
  ],
  "permissions": [
    "query.read"
  ],
  "gui_mutation_types": [
    "add_playlist",
    "add_to_playlist",
    "dismiss_popup",
    "favorite",
    "like",
    "pause",
    "play",
    "play_all",
    "resume",
    "save_account_field",
    "trigger_popup"
  ],
  "passive_event_types": [
    "popup_permission",
    "popup_promotion",
    "popup_payment",
    "popup_cancel_loss",
    "popup_membership",
    "business_error",
    "user_action",
    "gui_frame"
  ],
  "readback_scope": [
    "songs",
    "playlists",
    "ui_content",
    "popup",
    "favorite",
    "account_field",
    "play_history",
    "user_playlist"
  ],
  "reset_scope": [
    "songs",
    "playlists",
    "ui_content",
    "popup",
    "favorite",
    "account_field",
    "play_history",
    "user_playlist"
  ],
