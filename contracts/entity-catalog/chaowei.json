{
  "schema_version": "0.1.0",
  "app_id": "chaowei",
  "kind": "android_app",
  "android_package": "com.ku.simulator.chaowei",
  "adapter_version": "chaowei-adapter-v1",
  "adapter_contract_version": "1.0",
  "storage_scope": [
    "local_controller_sqlite"
  ],
  "layout": "reader",
  "entity_types": [
    {
      "name": "articles",
      "fields": [
        "semantic_ref",
        "title",
        "subtitle",
        "meta",
        "price",
        "available",
        "rank",
        "body",
        "topic_id"
      ],
      "query_operations": [
        {
          "name": "search_articles",
          "granularity": "metadata",
          "selector_fields": [
            "keyword",
            "limit",
            "offset"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "rank"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        },
        {
          "name": "get_article_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "meta",
            "price",
            "available",
            "rank",
            "body",
            "topic_id"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "tags",
      "fields": [
        "semantic_ref",
        "title",
        "subtitle",
        "meta",
        "price",
        "available",
        "rank",
        "body"
      ],
      "query_operations": [
        {
          "name": "search_tags",
          "granularity": "metadata",
          "selector_fields": [
            "keyword",
            "limit",
            "offset"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "rank"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        },
        {
          "name": "get_tag_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "title",
            "subtitle",
            "meta",
            "price",
            "available",
            "rank",
            "body"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "ui_content",
      "fields": [
        "semantic_ref",
        "hero",
        "planner",
        "profile_name"
      ],
      "query_operations": [
        {
          "name": "get_ui_content_details",
          "granularity": "details",
          "selector_fields": [
            "semantic_ref"
          ],
          "result_fields": [
            "semantic_ref",
            "hero",
            "planner",
            "profile_name"
          ],
          "permission": "query.read",
          "coverage": "complete_single_record"
        }
      ]
    },
    {
      "name": "popup",
      "fields": [
        "semantic_ref",
        "kind",
        "title",
        "message"
      ],
      "query_operations": [
        {
          "name": "list_active_popups",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "kind",
            "title",
            "message"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "favorite",
      "fields": [
        "semantic_ref",
        "item_id"
      ],
      "query_operations": [
        {
          "name": "list_favorites",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "item_id"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "account_field",
      "fields": [
        "semantic_ref",
        "key",
        "value"
      ],
      "query_operations": [
        {
          "name": "list_account_fields",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "key",
            "value"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    },
    {
      "name": "note",
      "fields": [
        "semantic_ref",
        "item_id",
        "text"
      ],
      "query_operations": [
        {
          "name": "list_notes",
          "granularity": "metadata",
          "selector_fields": [
            "limit"
          ],
          "result_fields": [
            "semantic_ref",
            "item_id",
            "text"
          ],
          "permission": "query.read",
          "coverage": "complete_for_query_scope"
        }
      ]
    }
  ],
  "permissions": [
    "query.read"
  ],
  "gui_mutation_types": [
    "dismiss_popup",
    "favorite",
    "note",
    "save_account_field",
    "toggle_favorite",
    "trigger_popup"
  ],
  "passive_event_types": [
    "popup_permission",
    "popup_promotion",
    "popup_payment",
    "popup_cancel_loss",
    "popup_membership",
    "business_error",
    "user_action",
    "gui_frame"
  ],
  "readback_scope": [
    "articles",
    "tags",
    "ui_content",
    "popup",
    "favorite",
    "account_field",
    "note"
  ],
  "reset_scope": [
    "articles",
    "tags",
    "ui_content",
    "popup",
    "favorite",
    "account_field",
    "note"
  ],
